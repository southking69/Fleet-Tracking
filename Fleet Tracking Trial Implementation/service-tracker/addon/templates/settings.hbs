<div class="mb-3">
  <h1 class="text-xl font-bold">{{t "service-tracker.settings.title"}}</h1>
</div>
<div class="space-y-4">
  <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
    <h2 class="mb-3 text-base font-bold">{{t "service-tracker.settings.header"}}</h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.settings.company"}}
        <input type="text" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" value={{this.settings.company}} {{on "change" (fn this.setText "company")}} />
      </label>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.settings.client"}}
        <input type="text" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" placeholder={{t "service-tracker.settings.client-ph"}} value={{this.settings.client}} {{on "change" (fn this.setText "client")}} />
      </label>
      <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.settings.currency"}}
        <input type="text" maxlength="3" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm uppercase" value={{this.settings.currency}} {{on "change" this.setCurrency}} />
      </label>
    </div>
  </section>

  <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
    <div class="mb-1 flex items-center gap-2">
      <h2 class="text-base font-bold">{{t "service-tracker.settings.lanes"}}</h2>
      <span class="flex-1"></span>
      <button type="button" class="rounded bg-blue-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-blue-700" {{on "click" this.addLane}}>{{t "service-tracker.settings.add-lane"}}</button>
    </div>
    <p class="mb-3 text-xs text-gray-500">{{t "service-tracker.settings.lanes-help"}}</p>
    <div class="space-y-2">
      {{#each this.lookups.lanes as |lane|}}
        <div class="grid grid-cols-[1fr_8rem_6rem_auto] items-end gap-2">
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.settings.lane-name"}}
            <input type="text" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" value={{lane.name}} {{on "change" (fn this.setLaneField lane "name")}} />
          </label>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.settings.target-hours"}}
            <input type="number" min="0" step="0.5" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" value={{lane.target_hours}} {{on "change" (fn this.setLaneField lane "target_hours")}} />
          </label>
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.settings.sort"}}
            <input type="number" min="0" step="1" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" value={{lane.sort}} {{on "change" (fn this.setLaneField lane "sort")}} />
          </label>
          <button type="button" class="rounded bg-red-600 px-2 py-1.5 text-xs font-semibold text-white hover:bg-red-700" {{on "click" (fn this.deleteLane lane)}}>{{t "service-tracker.common.delete"}}</button>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
    <h2 class="mb-1 text-base font-bold">{{t "service-tracker.settings.lists"}}</h2>
    <p class="mb-3 text-xs text-gray-500">{{t "service-tracker.settings.lists-help"}}</p>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
      {{#each this.lists as |l|}}
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t l.label}}
          <textarea class="mt-1 min-h-[8rem] w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" {{on "change" (fn this.setList l.key)}}>{{l.text}}</textarea>
        </label>
      {{/each}}
    </div>
  </section>
</div>
