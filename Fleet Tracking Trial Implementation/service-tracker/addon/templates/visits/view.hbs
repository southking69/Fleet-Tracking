<div class="mb-3 flex flex-wrap items-center gap-2">
  <LinkTo @route="visits" class="rounded border border-gray-300 dark:border-gray-600 px-3 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-800">← {{t "service-tracker.visit.all-visits"}}</LinkTo>
  <h1 class="text-xl font-bold">{{this.title}}</h1>
  <span class="flex-1"></span>
  {{#if this.visit.plate}}
    <button type="button" class="rounded border border-gray-300 dark:border-gray-600 px-3 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-800" {{on "click" this.carHistory}}>{{t "service-tracker.visit.car-history"}}</button>
  {{/if}}
  <button type="button" class="rounded bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700" {{on "click" this.clientReport}}>{{t "service-tracker.visit.client-report"}}</button>
  <button type="button" class="rounded bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-700" {{on "click" this.deleteVisit}}>{{t "service-tracker.visit.delete"}}</button>
</div>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_22rem]">
  <div class="min-w-0 space-y-4">
    {{!-- details --}}
    <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
      <h2 class="mb-3 text-base font-bold">{{t "service-tracker.visit.details"}}</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visit.plate"}}
          <input type="text" list="st-plates" placeholder="ABC 1234" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm uppercase" value={{this.visit.plate}} {{on "change" this.setPlate}} />
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visits.col.make"}}
          <input type="text" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" value={{this.visit.make_model}} {{on "change" (fn this.setText "make_model")}} />
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visit.technician"}}
          <SelectField @value={{this.visit.technician_uuid}} @options={{this.technicianOptions}} @onChange={{this.setTechnician}} class="mt-1" />
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visit.odometer"}}
          <input type="number" min="0" step="any" class="mt-1 w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" value={{this.visit.odometer}} {{on "change" (fn this.setNumber "odometer")}} />
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visit.arrived-lsa"}}
          <DatetimeNowField @value={{this.visit.arrived_at_lsa}} @onChange={{fn this.setField "arrived_at_lsa"}} class="mt-1" />
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visit.picked-up"}}
          <DatetimeNowField @value={{this.visit.picked_up_at}} @onChange={{fn this.setField "picked_up_at"}} class="mt-1" />
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300">{{t "service-tracker.visit.returned-lsa"}}
          <DatetimeNowField @value={{this.visit.returned_at}} @onChange={{fn this.setField "returned_at"}} class="mt-1" />
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={{this.visit.pickup_inspected}} {{on "change" (fn this.setCheck "pickup_inspected")}} /> {{t "service-tracker.visit.pickup-inspected"}}
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={{this.visit.return_inspected}} {{on "change" (fn this.setCheck "return_inspected")}} /> {{t "service-tracker.visit.return-inspected"}}
        </label>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 sm:col-span-2 lg:col-span-3">{{t "service-tracker.common.notes"}}
          <textarea class="mt-1 min-h-[4.5rem] w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm" {{on "change" (fn this.setText "notes")}}>{{this.visit.notes}}</textarea>
        </label>
      </div>
    </section>

    {{!-- condition photos --}}
    <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
      <h2 class="mb-1 text-base font-bold">{{t "service-tracker.visit.condition-photos"}}</h2>
      <p class="mb-3 text-xs text-gray-500">{{t "service-tracker.visit.condition-photos-help"}}</p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <h3 class="mb-1 text-sm font-semibold">{{t "service-tracker.visit.at-pickup" count=(st-photo-count this.visit.pickup_photos)}}</h3>
          <PhotoUploader @photos={{this.visit.pickup_photos}} @subject={{this.pickupSubject}} @label={{t "service-tracker.visit.add-pickup-photos"}} @hint={{t "service-tracker.visit.pickup-hint"}} @onChange={{this.conditionPhotosChanged}} />
        </div>
        <div>
          <h3 class="mb-1 text-sm font-semibold">{{t "service-tracker.visit.at-return" count=(st-photo-count this.visit.return_photos)}}</h3>
          <PhotoUploader @photos={{this.visit.return_photos}} @subject={{this.returnSubject}} @label={{t "service-tracker.visit.add-return-photos"}} @hint={{t "service-tracker.visit.return-hint"}} @onChange={{this.conditionPhotosChanged}} />
        </div>
      </div>
    </section>

    {{!-- vendor stops --}}
    <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-base font-bold">{{t "service-tracker.visit.stops-title"}}</h2>
        <span class="flex-1"></span>
        <button type="button" class="rounded bg-blue-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-blue-700" {{on "click" this.addStop}}>{{t "service-tracker.visit.add-stop"}}</button>
      </div>
      {{#each this.stopRows as |row|}}
        <VendorStopCard @stop={{row.stop}} @index={{row.index}} @info={{row.info}} @vendorOptions={{this.lookups.vendorOptions}} @onSaved={{this.refreshCalc}} @onDelete={{this.deleteStop}} />
      {{else}}
        <div class="py-4 text-center text-sm text-gray-500">{{t "service-tracker.visit.no-stops"}}</div>
      {{/each}}
    </section>

    {{!-- jobs --}}
    <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-base font-bold">{{t "service-tracker.visit.jobs-title"}}</h2>
        <span class="flex-1"></span>
        <button type="button" class="rounded bg-blue-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-blue-700" {{on "click" this.addJob}}>{{t "service-tracker.visit.add-job"}}</button>
      </div>
      {{#each this.jobRows as |row|}}
        <JobCard
          @job={{row.job}}
          @index={{row.index}}
          @info={{row.info}}
          @catalog={{this.lookups.catalog}}
          @vendorOptions={{this.lookups.vendorOptions}}
          @statuses={{this.settings.svcStatuses}}
          @onSaved={{this.refreshCalc}}
          @onDelete={{this.deleteJob}}
          @onCreateCatalog={{this.createCatalogItem}}
        />
      {{else}}
        <div class="py-4 text-center text-sm text-gray-500">{{t "service-tracker.visit.no-jobs"}}</div>
      {{/each}}
    </section>

    {{!-- petty cash --}}
    <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-base font-bold">{{t "service-tracker.visit.petty-title"}}</h2>
        <span class="flex-1"></span>
        <button type="button" class="rounded bg-blue-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-blue-700" {{on "click" this.addPetty}}>{{t "service-tracker.petty.add"}}</button>
      </div>
      {{#each this.petty as |entry|}}
        <PettyEditor @record={{entry}} @settings={{this.settings}} @visitOptions={{this.visitOptions}} @lockPlate={{true}} @onDelete={{this.deletePetty}} />
      {{else}}
        <div class="py-4 text-center text-sm text-gray-500">{{t "service-tracker.petty.none"}}</div>
      {{/each}}
    </section>

    {{!-- damage --}}
    <section class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-base font-bold">{{t "service-tracker.visit.damage-title"}}</h2>
        <span class="flex-1"></span>
        <button type="button" class="rounded bg-blue-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-blue-700" {{on "click" this.addDamage}}>{{t "service-tracker.visit.add-damage"}}</button>
      </div>
      {{#each this.damages as |record|}}
        <DamageEditor @record={{record}} @settings={{this.settings}} @userOptions={{this.lookups.userOptions}} @onSaved={{this.refreshCalc}} @onChanged={{this.refreshCalc}} @onDelete={{this.deleteDamage}} />
      {{else}}
        <div class="py-4 text-center text-sm text-gray-500">{{t "service-tracker.visit.no-damage"}}</div>
      {{/each}}
    </section>
  </div>

  <aside class="lg:sticky lg:top-4 lg:self-start">
    <VisitSummary @calc={{this.calc}} @visit={{this.visit}} @damageCount={{this.damages.length}} @newDamageCount={{this.newDamageCount}} />
  </aside>
</div>
