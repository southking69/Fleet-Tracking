<div class="flex items-center gap-1.5" ...attributes>
  <input
    type="datetime-local"
    class="min-w-0 flex-1 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1.5 text-sm"
    value={{this.localValue}}
    disabled={{@disabled}}
    {{on "change" this.change}}
  />
  <button
    type="button"
    class="shrink-0 rounded bg-blue-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 disabled:opacity-50"
    title={{t "service-tracker.common.now-title"}}
    disabled={{@disabled}}
    {{on "click" this.now}}
  >{{t "service-tracker.common.now"}}</button>
</div>
