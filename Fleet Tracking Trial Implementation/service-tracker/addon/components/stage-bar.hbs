<div class="space-y-1.5" ...attributes>
  {{#each this.rows as |r|}}
    <div class="grid grid-cols-[8.5rem_1fr_3rem] items-center gap-2 text-xs" title={{r.owner}}>
      <span class="{{if r.big "font-bold text-red-700 dark:text-red-400"}}">{{r.label}}</span>
      <div class="h-2.5 overflow-hidden rounded bg-gray-200 dark:bg-gray-700">
        <i class="block h-full rounded {{if r.big "bg-red-600" "bg-blue-500"}}" style={{st-bar-width r.value this.max}}></i>
      </div>
      <span class="text-right tabular-nums">{{fmt-hours r.value}}</span>
    </div>
  {{/each}}
</div>
