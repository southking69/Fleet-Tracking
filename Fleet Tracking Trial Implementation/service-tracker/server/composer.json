{
    "name": "jalal/service-tracker-api",
    "description": "Fleet service turnaround, vendor stops, damage and petty cash tracking for Fleetbase FleetOps.",
    "keywords": [
        "fleetbase-extension",
        "service-tracker",
        "fleetops",
        "fleet-maintenance"
    ],
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Jalal Holding"
        }
    ],
    "require": {
        "php": "^8.1",
        "fleetbase/core-api": "^1.6",
        "fleetbase/fleetops-api": "0.6.71",
        "spatie/laravel-activitylog": "^4.7",
        "maatwebsite/excel": "^3.1",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Jalal\\ServiceTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jalal\\ServiceTracker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jalal\\ServiceTracker\\Providers\\ServiceTrackerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
