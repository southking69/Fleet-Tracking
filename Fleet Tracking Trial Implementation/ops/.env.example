# Copy to `.env` in the ROOT of the Fleetbase checkout (next to docker-compose.yml). Never commit the real file.
# These are Docker Compose interpolation variables read by docker-compose.override.yml.
# Generate secrets with:  openssl rand -hex 20      (use hex: the DB password is embedded in a URL, so avoid @ / : # characters)
#                         echo "base64:$(openssl rand -base64 32)"     (APP_KEY)

# ---- public hostnames (HTTPS is terminated by the reverse proxy, see ops/docker/Caddyfile.example) ----
API_FQDN=api.fleet.example.com
CONSOLE_FQDN=fleet.example.com
# https for real use; the integration workflow sets http for localhost
APP_SCHEME=https
# cookie domain shared by both hosts (leading dot form works for sub-domains of one parent)
SESSION_DOMAIN=.fleet.example.com
# extra CORS origins, comma separated (leave empty if none)
FRONTEND_HOSTS=

# ---- application ----
APP_NAME=Jalal Fleet
APP_KEY=
# system clock of the app containers (logs only; Fleetbase itself stays UTC, see the override file)
TZ=Asia/Riyadh

# ---- database (bundled MySQL 8) ----
DB_ROOT_PASSWORD=
DB_USERNAME=fleetbase
DB_PASSWORD=
DB_PORT=3306

# ---- image names / build ----
# Stock image the extension is layered on. Pin a version tag you tested instead of `latest` for anything beyond a trial.
FLEETBASE_API_BASE_IMAGE=fleetbase/fleetbase-api:latest
JALAL_API_IMAGE=jalal/fleetbase-api:service-tracker
# optional GitHub token if composer needs to fetch Fleetbase packages from GitHub during `docker compose build`
GITHUB_AUTH_KEY=

# ---- file storage: public (local disk, default) | s3 | gcs ----
FILESYSTEM_DRIVER=public
# s3 (also works for S3-compatible stores: set AWS_URL + AWS_USE_PATH_STYLE_ENDPOINT=true)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# gcs
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_KEY_FILE=

# ---- mail: `log` writes mails to storage/logs (fine for a closed trial, but then verification codes must be read from the log) ----
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=fleet@example.com
MAIL_FROM_NAME=Jalal Fleet

# ---- integration smoke test only (ops/smoke/smoke.sh); leave empty in production ----
# SMOKE_* are written by ops/smoke/bootstrap.sh; documented in ops/smoke/smoke.sh
